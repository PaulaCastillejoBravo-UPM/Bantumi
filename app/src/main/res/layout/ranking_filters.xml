<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="4dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_margin="4dp"
        >
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/txtFiltroJugador"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerJugador"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:contentDescription="@string/txtJugadorSpinner" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_margin="4dp"
        >
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/txtFiltroFecha"
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonFecha"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/txtFechaSelector"
            android:textAllCaps="false" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_margin="4dp"
        >
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/txtFiltroSemillasExactas"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editTextSemillas"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/txtSemillasExactasEjemplo"
            android:inputType="number"
            android:singleLine="true" />
    </LinearLayout>


    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_margin="4dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/buttonAplicarFiltros"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:padding="8dp"
            android:src="@drawable/filter_alt_24px"
            android:contentDescription="@string/txtAplicarFiltros"
            android:scaleType="center"
            android:background="?attr/selectableItemBackground"
            android:adjustViewBounds="true"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:gravity="center_vertical" />

        <ImageButton
            android:id="@+id/buttonLimpiarFiltros"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:padding="8dp"
            android:src="@drawable/filter_alt_off_24px"
            android:contentDescription="@string/txtLimpiarFiltros"
            android:scaleType="center"
            android:background="?attr/selectableItemBackground"
            android:adjustViewBounds="true"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:gravity="center_vertical"/>

    </LinearLayout>

</LinearLayout>
